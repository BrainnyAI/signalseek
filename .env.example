# SignalSeek Environment Variables
# Copy to .env and fill in

# JWT signing secret (use a random string in production)
SECRET_KEY=change-me-in-production

# Telegram Bot Token from @BotFather (required for alerts)
TELEGRAM_BOT_TOKEN=

# StackExchange API key (optional, for higher rate limits)
# Get at https://stackapps.com/apps/oauth/register
STACKEXCHANGE_KEY=

# Reddit API (optional, requires app registration)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
